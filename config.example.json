{
  "provider": "minimax",
  "fallback_providers": [],
  "providers": {
    "minimax": {
      "api_key": "",
      "base_url": "https://api.minimaxi.com/v1/chat/completions",
      "model": "MiniMax-M3",
      "thinking_param": {"type": "adaptive"},
      "max_tokens_field": "max_completion_tokens"
    },
    "deepseek": {
      "api_key": "",
      "base_url": "https://api.deepseek.com/chat/completions",
      "model": "deepseek-v4-flash",
      "thinking_param": {"type": "enabled"},
      "max_tokens_field": "max_completion_tokens"
    },
    "opencode": {
      "api_key": "",
      "base_url": "https://opencode.ai/zen/v1/chat/completions",
      "model": "glm-5.2",
      "thinking_param": null,
      "max_tokens_field": "max_tokens"
    },
    "qwen": {
      "api_key": "",
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions",
      "model": "qwen3.8-max-preview",
      "thinking_param": null,
      "max_tokens_field": "max_tokens"
    }
  },
  "excel_folder": "./excel_files",
  "excel_extensions": [".xlsx", ".xls", ".xlsm"],
  "output_format": "markdown",
  "output_folder": "reports",
  "output_file_template": "Vue{last_week_range}周报",
  "output_file": "",
  "tokens_to_generate": 4096,
  "temperature": 0.3,
  "max_chars_per_sheet": 30000,
  "custom_prompt": "",
  "thinking_enabled": false,
  "timeout": 180,
  "crm": {
    "enabled": false,
    "url": "https://crm.example.com/ipd/rest/v1/workHourReport/integration/exportWorkHourItems",
    "token": "",
    "userid": "",
    "tyinjectparams": "",
    "org_oid_list": ["YOUR_ORG_OID_HERE"],
    "user_oid_list": [],
    "project_oid_list": [],
    "download_dir": "excel_files",
    "export_prefix": "",
    "timeout": 60,
    "login_url": "https://crm.example.com/rest/userService/v1/user/userLoginPlm",
    "username": "",
    "password": "",
    "app_id": "Chrome(149.0.0.0)"
  },
  "email": {
    "enabled": false,
    "smtp_host": "smtp.exmail.qq.com",
    "smtp_port": 465,
    "sender": "",
    "password": "",
    "recipients": [],
    "cc": [],
    "subject_template": "Vue 周报 {last_week_range}",
    "attach_report": true,
    "max_chars": 30000
  },
  "contact_info": {
    "email": "your_email@example.com",
    "phone": "13800138000",
    "dingtalk": "本机器人"
  },
  "notification": {
    "templates": {
      "weekly_notice": {
        "title": "周报通知",
        "template": "**各位领导好：**\n\n**重要通知：** 自本周起，周报将统一通过本钉钉机器人发送，后续请留意机器人消息提醒，及时查收周报内容。\n\n---\n\n**联系方式**\n- 钉钉：{dingtalk}\n- 邮箱：{email}\n- 电话：{phone}\n\n---\n\n{footer}"
      },
      "failure_alert": {
        "title": "周报生成失败",
        "template": "## 周报生成失败\n\n本周周报自动生成流程出现异常，详情如下：\n\n{error_summary}\n\n请检查日志或联系系统管理员处理。\n\n---\n\n**联系方式**\n- 钉钉：{dingtalk}\n- 邮箱：{email}\n- 电话：{phone}"
      },
      "crm_reminder": {
        "title": "CRM 填写提醒",
        "template": "## 周五 CRM 填写提醒\n\n{names}\n\n请记得在今天下班前完成 **CRM 工时填写**，谢谢配合！\n\n- **截止时间**：今天 17:00 前\n\n---\n\n{footer}"
      }
    }
  },
  "retry": {
    "max_retries": 2,
    "base_delay": 1.0,
    "backoff": 2.0
  },
  "dingtalk": {
    "enabled": false,
    "app_key": "",
    "app_secret": "",
    "approver_staff_ids": [],
    "recipient_staff_ids": [],
    "open_conversation_id": "",
    "confirm_keywords": ["发送", "send", "确认", "ok"],
    "cancel_keywords": ["取消", "cancel", "放弃", "不发送"],
    "timeout_minutes": 30,
    "preview_max_chars": 12000
  },
  "attendance": {
    "user_ids": [],
    "start_date": "",
    "end_date": "",
    "output_folder": "attendance_output"
  },
  "crm_reminder": {
    "enabled": false,
    "send_weekday": 4,
    "skip_holiday": true,
    "conversation_id": "",
    "remind_user_ids": []
  }
}
